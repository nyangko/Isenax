    "dev": "node --watch src/index.js",
    "test": "node test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "isenax": "workspace:*",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
