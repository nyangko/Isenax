{
  "name": "isenax-mcp",
  "version": "1.5.0",
  "description": "MCP server exposing Isenax diagrams as tools for AI agents",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./http-handler": "./src/httpHandler.js"
  },
  "bin": {
    "isenax-mcp": "src/index.js"
  },
  "scripts": {
